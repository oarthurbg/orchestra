#!/bin/sh
# orchestra branch guard: refuses direct pushes (and deletions) to the permanent branches on
# the main remote. They change only through PRs. Set them per clone with:
#   git config orchestra.protectedBranches "<integration branch> <production branch>"
#   git config orchestra.protectedRemote origin    # optional, origin by default
set -f
remote_name=$1
protected=$(git config --get orchestra.protectedBranches)
if [ -z "$protected" ]; then
  echo "orchestra: branch guard installed but orchestra.protectedBranches is not set; nothing is protected." >&2
  exit 0
fi
guarded=$(git config --get orchestra.protectedRemote || echo origin)
[ "$remote_name" = "$guarded" ] || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  for branch in $protected; do
    if [ "$remote_ref" = "refs/heads/$branch" ]; then
      echo "orchestra: direct push to '$branch' refused. It changes only through a PR." >&2
      exit 1
    fi
  done
done
exit 0
