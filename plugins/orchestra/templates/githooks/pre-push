#!/bin/sh
# orchestra branch guard: refuses direct pushes (and deletions) to the permanent branches.
# They change only through PRs. Set them per clone with:
#   git config orchestra.protectedBranches "<integration branch> <production branch>"
protected=$(git config --get orchestra.protectedBranches)
[ -z "$protected" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  for branch in $protected; do
    if [ "$remote_ref" = "refs/heads/$branch" ]; then
      echo "orchestra: direct push to '$branch' refused. It changes only through a PR." >&2
      exit 1
    fi
  done
done
exit 0
